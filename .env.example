# PAPER uses the public Deriv WebSocket for market data and simulates execution locally.
TRADING_MODE=paper

# Store these only in the protected server environment. Never expose them with NEXT_PUBLIC_*.
DERIV_CLIENT_ID=
DERIV_CLIENT_SECRET=
DERIV_ACCESS_TOKEN=
DERIV_ACCOUNT_ID=
DERIV_AUTH_METHOD=oauth

# Safety gates. The server must obtain a one-time WebSocket URL from the Deriv OTP endpoint.
DERIV_DEMO_VALIDATED=false
DERIV_LIVE_UNLOCKED=false
