# Paper is the only executable mode until the cTrader application is approved.
TRADING_MODE=paper

# Store these only in the protected server environment. Never expose them with NEXT_PUBLIC_*.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=

# Safety gates. Enabling these values is not sufficient by itself: the server bridge
# must also pass authentication, reconciliation, stop-loss and emergency-stop checks.
CTRADER_APP_APPROVED=false
CTRADER_DEMO_VALIDATED=false
CTRADER_LIVE_UNLOCKED=false
